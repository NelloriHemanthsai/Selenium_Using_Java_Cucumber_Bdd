package com.redbus.pages;

import org.openqa.selenium.By;
import java.time.Duration;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import java.util.List;

public class DashboardPage {

    private WebDriver driver;
    private WebDriverWait wait;

    private By products =
            By.cssSelector(".card-body h5 b");

//    private By productTitles =
//            By.cssSelector(".card-body b");


    public DashboardPage(WebDriver driver) {

        this.driver = driver;
        this.wait = new WebDriverWait(
                driver, Duration.ofSeconds(15));
    }


    public void addProductToCart(String productName) {
    	System.out.println("dash board entered");

        // Wait until product titles are visible
        List<WebElement> productList =
                wait.until(
                    ExpectedConditions.visibilityOfAllElementsLocatedBy(
                            products));
    	
//    	 List<WebElement> productList =
//                 driver.findElements(products);
    	 	
    	 System.out.println("product list : " + productList);
         System.out.println(
                 "Products found: " + productList.size());

         for (WebElement product : productList) {
        	 
        	 System.out.println("entered for loop");

             String productTitle =
                     product.findElement(
                             By.cssSelector("h5 b")
                     ).getText();


             System.out.println(
                     "Product found: " + productTitle
             );


             if (productTitle.equalsIgnoreCase(productName)) {

                 WebElement addToCartButton =
                         product.findElement(
                                 By.xpath(
                                     ".//button[contains(.,'Add To Cart')]"
                                 )
                         );
                 
                 addToCartButton.click();
                 
                 System.out.println("dash board completed ");

                 break;
             }
         }
       
    }
}